{
  "mcpServers": {
    "wikipedia-mcp": {
      "command": "bin/site-mcp",
      "args": [
        "wikipedia"
      ],
      "env": {
        "TYPESAFE_API_KEY": "${TYPESAFE_API_KEY}"
      }
    },
    "outlook-mcp": {
      "command": "bin/site-mcp",
      "args": [
        "outlook"
      ],
      "env": {
        "TYPESAFE_API_KEY": "${TYPESAFE_API_KEY}"
      }
    }
  }
}
